  "paths": {
    "/api/v1/analisis/buffer": {
      "post": {
        "description": "Buffer en metros reales sobre una capa; el resultado sale en EPSG:4326.",
        "operationId": "analisis_buffer_api_v1_analisis_buffer_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BufferAnalisisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BufferAnalisisResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorAnalisisResponse"
                }
              }
            },
            "description": "consulta_rechazada: PostgreSQL rechazó la consulta"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorAnalisisResponse"
                }
              }
            },
            "description": "capa_no_consultable · columna_inexistente · sin_columnas_texto, o body inválido (formato FastAPI)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorAnalisisResponse"
                }
              }
            },
            "description": "error_interno"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorAnalisisResponse"
                }
              }
            },
            "description": "bd_no_disponible"
          }
        },
        "summary": "Analisis Buffer"
      }
    },
