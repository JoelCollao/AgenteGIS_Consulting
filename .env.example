# agent-service · variables de entorno. Local: copia este archivo a `.env`. Producción: no hay .env, las variables de la PARTE 2 se inyectan en el contenedor.
# Aquí NO van cadenas de conexión a base de datos ni a Redis: los datos se piden al backend por HTTP.


# ═════════════════════════════════════════════════════════════════════════
#  PARTE 1 · LOCAL  (lo que va en tu .env)
# ═════════════════════════════════════════════════════════════════════════

# ── 1.1 Servidor ─────────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8001
CORS_ALLOWED_ORIGINS=
DEBUG_ERRORS=false
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── 1.2 Backend GIS (único origen de datos) ──────────────────────────────
BACKEND_URL=http://localhost:5000
BACKEND_CONNECT_TIMEOUT=5
BACKEND_READ_TIMEOUT=30
BACKEND_MAX_CONNECTIONS=20

# ── 1.3 Autenticación (JWT) ──────────────────────────────────────────────
# El MISMO secreto que el backend: aquí solo se validan los tokens que él emite.
JWT_SECRET=
# JWT_ISSUER=gis-backend-app
# JWT_ALGORITHM=HS256


# ── 1.4 Modelo de IA ─────────────────────────────────────────────────────
# Activa UNO: pon su LLM_PROVIDER y descomenta sus variables; comenta el resto.
# Solo modelos de razonamiento (gpt-5*, o*): minimal | low | medium | high.
# Vacío = el del modelo. No aplica a azure_agent (lo fija el agente).
# LLM_REASONING_EFFORT=low

# a) azure_agent · agente del portal de Foundry (requiere `az login`)
# LLM_PROVIDER=azure_agent
# AZURE_PROJECT_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<proyecto>
# AZURE_AGENT_NAME=<nombre-del-agente>
# AZURE_AGENT_VERSION=
# AZURE_TENANT_ID=

# b) azure_foundry · modelo de Foundry (requiere `az login`)
# LLM_PROVIDER=azure_foundry
# AZURE_PROJECT_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<proyecto>
# AZURE_OPENAI_DEPLOYMENT=<deployment>
# AZURE_TENANT_ID=
# OPENAI_API_VERSION=

# c) azure · Azure OpenAI con API key (sirve fuera de Azure)
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=<deployment>
# AZURE_OPENAI_API_VERSION=

# d) otros: openai, kimi, deepseek, groq, openrouter, mistral, ollama
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# LLM_MODEL=
# d.2) openrouter_free · varios modelos gratuitos: si uno da 429 salta al siguiente
# LLM_PROVIDER=openrouter_free
# OPENROUTER_API_KEY=
# Opcional: modelo principal y reservas (sin esto usa los del preset)
# LLM_MODEL=
# LLM_FALLBACK_MODELS=


# ── 1.5 Telemetría de costo (opcional) ───────────────────────────────────
# USD por millón de tokens. Sin ellas, los logs llm.call llevan cost_usd=null.
# LLM_PRICE_INPUT_PER_1M=
# LLM_PRICE_OUTPUT_PER_1M=

# ── 1.6 Políticas de tools ───────────────────────────────────────────────
# Vacío = config/policies.yaml
# POLICIES_FILE=


# ═════════════════════════════════════════════════════════════════════════
#  PARTE 2 · PRODUCCIÓN  (Container Apps; referencia, no se copia al .env)
# ═════════════════════════════════════════════════════════════════════════
# ENVIRONMENT=production
# PORT=8001
# CORS_ALLOWED_ORIGINS=https://<frontend>            # sin barra final; vacío = ningún origen
# BACKEND_URL=http://<backend-container-app>         # FQDN interno del entorno de Container Apps
# JWT_SECRET=<el mismo que el backend>               # secretref al MISMO secreto de Key Vault
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...   # secreto: secretref
# LLM_PROVIDER=azure_agent
# AZURE_PROJECT_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<proyecto>
# AZURE_AGENT_NAME=<nombre-del-agente>
# AZURE_AGENT_VERSION=<version fija>
# LLM_REASONING_EFFORT=low
